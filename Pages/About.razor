@page "/about"
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>About | Prushti Pithadiya</PageTitle>

@if (_p is null)
{
    <p class="muted">Loading…</p>
}
else
{
    <section class="section">
        <h2 class="reveal">About me</h2>
        <p class="reveal" style="max-width:720px">@_p.Bio</p>
        <div class="hero-actions reveal">
            <a class="btn primary" href="resume.pdf" target="_blank" rel="noopener">View resume</a>
        </div>
    </section>

    <section class="section">
        <h2 class="reveal">Skills</h2>
        @foreach (var (group, skills) in _p.Skills)
        {
            <div class="skill-group reveal">
                <h3>@group</h3>
                <div class="badges">@foreach (var s in skills) { <SkillBadge Text="@s" /> }</div>
            </div>
        }
        <div class="skill-group reveal">
            <h3>Soft skills</h3>
            <div class="badges">@foreach (var s in _p.SoftSkills) { <SkillBadge Text="@s" /> }</div>
        </div>
        <div class="skill-group reveal">
            <h3>Languages</h3>
            <div class="badges">@foreach (var s in _p.Languages) { <SkillBadge Text="@s" /> }</div>
        </div>
    </section>

    <section class="section">
        <h2 class="reveal">Education</h2>
        <div class="grid">
            @foreach (var e in _p.Education)
            {
                <div class="card glass reveal">
                    <h3>@e.Title</h3>
                    <p>
                        @if (e.Place is not null) { <text>@e.Place · </text> }@e.Period
                        @if (e.Score is not null) { <text> · @e.Score</text> }
                    </p>
                </div>
            }
        </div>
    </section>

    <section class="section">
        <h2 class="reveal">Achievements</h2>
        <div class="grid">
            @foreach (var a in _p.Achievements)
            {
                <div class="card glass reveal"><h3>@a.Title</h3><p>@a.Description</p></div>
            }
        </div>
    </section>
}

@code {
    private Profile? _p;
    protected override async Task OnInitializedAsync()
        => _p = await Http.GetFromJsonAsync<Profile>("data/profile.json");
}